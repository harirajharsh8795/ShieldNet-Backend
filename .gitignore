# NetGuard — Ignore patterns

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Virtual environments
venv/
.venv/
env/

# Data (too large for git)
data/raw/
data/processed/
data/external/
dataset/
*.pcap
*.pcapng
*.parquet

# Model checkpoints (large)
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.joblib
!models/checkpoints/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Logs & temp
*.log
scratch/
.system_generated/

# Environment
.env
